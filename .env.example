# Optional OpenAI-compatible LLM (offline mode works without these)
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini

# Extra embed origins (comma-separated full URLs)
# ALLOWED_ORIGINS=https://www.myclient.com,https://myclient.com

# Optional lead sinks (default: local SQLite + CSV only)
# LEAD_SINK_GOOGLE_SHEETS=true
# GOOGLE_SHEETS_WEBHOOK_URL=
# LEAD_SINK_HUBSPOT=true
# HUBSPOT_PRIVATE_APP_TOKEN=
